# Local Kimai test environment — copy to .env and fill in values.
# This file is safe to commit. .env is gitignored.

# Kimai admin credentials (set by tests/docker/init-kimai.sh)
KIMAI_ADMIN_USER=kimai-admin
KIMAI_ADMIN_PASSWORD=Admin1234!

# API token — generated after first `docker compose up`.
# Store in .NET user secrets instead of here for the OData service:
#   dotnet user-secrets set "Kimai:Url" "http://localhost:8001"
#   dotnet user-secrets set "Kimai:Password" "<token>"
KIMAI_API_TOKEN=
